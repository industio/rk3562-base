+			list_del(&cmd->list);
+			cmd_mgr->queue_sz--;
 			spin_unlock_bh(&cmd_mgr->lock);
+			rwnx_cmd_free(cmd);
 		} else {
 			spin_lock_bh(&cmd_mgr->lock);
 			list_del(&cmd->list);
